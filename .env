# JID de WhatsApp del administrador para recibir notificaciones de nuevas reservas
# Formato: número sin + ni espacios, seguido de @s.whatsapp.net
# Ejemplo: 56951307009@s.whatsapp.net
ADMIN_WHATSAPP_JID=56951307009@s.whatsapp.net

# ─────────────────────────────────────────────
# SELECTOR DE PROVEEDOR DE IA: 'gemini' o 'ollama'
# ─────────────────────────────────────────────
AI_PROVIDER=gemini

# Configuración Gemini
GEMINI_MODEL=gemini-3.6-flash

# Configuración Ollama Local
OLLAMA_HOST=http://localhost:11434
#OLLAMA_MODEL=deepseek-chat-v2-lite:iq4xs
OLLAMA_MODEL=akuldatta/deepseek-chat-v2-lite:iq4xs

# ─────────────────────────────────────────────
# GESTIÓN DE EXPIRACIÓN Y RETENCIÓN DE RESERVAS
# ─────────────────────────────────────────────
# Tiempo en horas que se bloquea la cabaña mientras espera pago del 20% (ej: 2, 4, 12, 24)
RESERVA_EXPIRACION_HORAS=24

# Minutos antes de que expire la reserva para enviar recordatorio por WhatsApp (ej: 30, 60)
RESERVA_RECORDATORIO_MINUTOS=60

# Intervalo en minutos con el que el bot verifica expiraciones en la base de datos (ej: 1, 2, 5)
RESERVA_CHECK_INTERVALO_MINUTOS=120

# ¿Enviar recordatorio automático antes de que expire? (true / false)
RESERVA_NOTIFICAR_RECORDATORIO=true

# ¿Enviar mensaje al cliente si su reserva expiró y la cabaña fue liberada? (true / false)
RESERVA_NOTIFICAR_EXPIRACION=true